2], [3, 4], [5]], "scene_events": [[[0]], [[1]], [[2], []], [[3], [4]], [[5]]], "narrator_hash": "85336a76f72a30b9238099672d25cb8754543602bcc4654fe1570f2a6f204bbc", "checksum": "212ed1ce46a580300f526c56c5019dc26f52c36dd0582606a243cf273397d5bc"}}
{"time": "2026-10-26T18:03:06.899+00:00", "event": "narrator_checkpoint", "checkpoint": {"version": 2, "plot": {"title": "いちばん近くの、初恋", "premise": {"$input": ["premise"]}, "turn_budget": 100, "milestones": [{"$input": ["milestones", 0]}, {"$input": ["milestones", 1]}, {"$input": ["milestones", 2]}, {"$input": ["milestones", 3]}, "悠真は葵の告白に対し、自分も昔から葵が好きだったと明言する。", {"$input": ["milestones", 5]}], "characters": {"narrator": {"speech_style": {"$input": ["characters", "narrator", "speech_style"]}}, "瀬川悠真": {"speech_style": {"$input": ["characters", "瀬川悠真", "speech_style"]}, "thought_style": {"$input": ["characters", "瀬川悠真", "thought_style"]}, "background": {"$input": ["characters", "瀬川悠真", "background"]}, "how_perceived": {"self": {"$input": ["characters", "瀬川悠真", "how_perceived", "self"]}, "others": {"$input": ["characters", "瀬川悠真", "how_perceived", "others"]}, "小野寺葵": {"$input": ["characters", "瀬川悠真", "how_perceived", "小野寺葵"]}, "水瀬莉緒": {"$input": ["characters", "瀬川悠真", "how_perceived", "水瀬莉緒"]}}}, "小野寺葵": {"speech_style": {"$input": ["characters", "小野寺葵", "speech_style"]}, "thought_style": {"$input": ["characters", "小野寺葵", "thought_style"]}, "background": {"$input": ["characters", "小野寺葵", "background"]}, "how_perceived": {"self": {"$input": ["characters", "小野寺葵", "how_perceived", "self"]}, "others": {"$input": ["characters", "小野寺葵", "how_perceived", "others"]}, "瀬川悠真": {"$input": ["characters", "小野寺葵", "how_perceived", "瀬川悠真"]}, "水瀬莉緒": {"$input": ["characters", "小野寺葵", "how_perceived", "水瀬莉緒"]}}}, "水瀬莉緒": {"speech_style": {"$input": ["characters", "水瀬莉緒", "speech_style"]}, "thought_style": {"$input": ["characters", "水瀬莉緒", "thought_style"]}, "background": {"$input": ["characters", "水瀬莉緒", "background"]}, "how_perceived": {"self": {"$input": ["characters", "水瀬莉緒", "how_perceived", "self"]}, "others": {"$input": ["characters", "水瀬莉緒", "how_perceived", "others"]}, "瀬川悠真": {"$input": ["characters", "水瀬莉緒", "how_perceived", "瀬川悠真"]}, "小野寺葵": {"$input": ["characters", "水瀬莉緒", "how_perceived", "小野寺葵"]}}}}}, "story": {"title": "いちばん近くの、初恋", "turn_budget": 100, "opening": "幼馴染である悠真と葵が過ごす穏やかな日常から、転校生・莉緒の告白によって引き起こされる感情の波、そして葵が自らの恋心に気づき、二人が結ばれるまでの過程を描く。", "chapters": [{"title": "いつもの放課後", "synopsis": "悠真と葵の気安いやり取り。莉緒も加わり、三人の微妙な距離感と幼馴染としての親密さが描かれる。", "turn_budget": 15, "scenes": [{"synopsis": "放課後の教室で、悠真と葵が幼馴染らしい親密な会話を交わしているところに莉緒が加わり、三人の間に流れる微妙な空気感を描く。", "turn_budget": 15, "time_point": "放課後", "location": "教室", "turns": [{"speaker": null, "speech": null, "thought": null, "narration": "放課後の教室。夕暮れのオレンジ色の光が、机を並べて座る悠真と葵を照らしている。"}, {"speaker": "小野寺葵", "speech": "ねえ悠真、今日の購買のパン、まだ残ってたよ。これ、あんたが好きそうなメロンパン", "thought": "当たり前", "narration": null}, {"speaker": "瀬川悠真", "speech": "あ、サンキュ。よく覚えてんな", "thought": "照れ隠し", "narration": null}, {"speaker": "小野寺葵", "speech": "当たり前じゃん。あんたの好みなんて、全部把握済みだよ", "thought": "自信", "narration": null}, {"speaker": "瀬川悠真", "speech": "はいはい、お母さんみたいだな", "thought": "困惑", "narration": null}, {"speaker": "小野寺葵", "speech": "明日も一緒に帰るからね。遅れないように来なさいよ", "thought": "当然", "narration": null}, {"speaker": null, "speech": null, "thought": null, "narration": "教室の入り口から、莉緒が足音を立てて近づいてくる。彼女の視線は真っ直ぐに悠真に向けられている。"}, {"speaker": "水瀬莉緒", "speech": "瀬川くん、まだ残ってたんだね", "thought": "喜び", "narration": null}, {"speaker": "瀬川悠真", "speech": "あ、水瀬さん。うん、ちょっと片付けを", "thought": "驚き", "narration": null}, {"speaker": "水瀬莉緒", "speech": "ふふ、お疲れ様。私も、瀬川くんと少し話したかったんだ", "thought": "意欲", "narration": null}, {"speaker": null, "speech": null, "thought": null, "narration": "葵の視線が莉緒に向き、一瞬だけ強張る。三人の間に、言葉にできない微妙な緊張感が漂い始めた。"}, {"speaker": "小野寺葵", "speech": "何か用？ 水瀬さん", "thought": "独占欲", "narration": null}, {"speaker": "水瀬莉緒", "speech": "あ、小野寺さん。ちょっとだけ、瀬川くんとお話ししてもいいかな？", "thought": "積極的", "narration": null}, {"speaker": "瀬川悠真", "speech": "あ、うん。そんなに長くかからないなら……", "thought": "困惑", "narration": null}, {"speaker": null, "speech": null, "thought": null, "narration": "莉緒の積極的な態度に、悠真は困惑し、葵は無意識に悠真との距離を詰める。"}]}]}, {"title": "一目惚れの告白", "synopsis": "莉緒が悠真を二人きりの場所へ呼び出し、転校初日に感じた一目惚れを理由に交際を申し込む。", "turn_budget": 15, "scenes": [{"synopsis": "放課後の静かな教室で、莉緒が悠真を二人きりになるよう呼び出す。莉緒は、転校初日に慣れない環境で自然に助けてくれた悠真の姿に一目惚れしたことを正直に打ち明け、彼に付き合ってほしいと真剣な表情で告白する。", "turn_budget": 15, "time_point": "放課後", "location": "放課後の教室", "turns": [{"speaker": null, "speech": null, "thought": null, "narration": "夕暮れ時の教室。部活動や下校の準備が終わり、静まり返った空間に莉緒が悠真に歩み寄る。"}, {"speaker": "水瀬莉緒", "speech": "瀬川くん、ちょっと二人だけで話せるかな？", "thought": "緊張", "narration": "莉緒は少しだけ声を震わせながら、真っ直ぐに悠真の目を見つめる。"}, {"speaker": "瀬川悠真", "speech": "え、あ、うん。どうしたの？", "thought": "困惑", "narration": "悠真は突然の呼び出しに戸惑いながらも、彼女の真剣な表情に圧倒される。"}, {"speaker": null, "speech": null, "thought": null, "narration": "莉緒に促されるまま、二人は教室の隅、窓際の死角へと移動する。"}, {"speaker": "水瀬莉緒", "speech": "あのね、私、転校してきた初日に瀬川くんを見て、一目惚れしたの。", "thought": "決意", "narration": "莉緒の頬は朱に染まっているが、その瞳には迷いがない。"}, {"speaker": "水瀬莉緒", "speech": "慣れない教室で、周りに気を遣いながらも自然に助けてくれたところ。", "thought": "回想", "narration": "莉緒は当時の光景を思い出すように、視線を少し落とす。"}, {"speaker": "水瀬莉緒", "speech": "あの優しさが、私にとってすごく眩しくて、もっと知りたいって思ったんだ。", "thought": "切実", "narration": "彼女は胸元で手をぎゅっと握りしめる。"}, {"speaker": "水瀬莉緒", "speech": "瀬川くんのこと、ずっと気になっていたの。", "thought": "告白", "narration": "莉緒は一歩踏み込み、二人の距離が縮まる。"}, {"speaker": "水瀬莉緒", "speech": "だから、私と付き合ってほしい。", "thought": "懇願", "narration": "莉緒は最後の一言を絞り出すように、切実な願いを込めて伝えた。"}, {"speaker": "水瀬莉緒", "speech": "お願い、私の気持ち、受け止めてくれるかな？", "thought": "祈り", "narration": "彼女は潤んだ瞳で悠真の返答を待つ。"}, {"speaker": "瀬川悠真", "speech": "え……。", "thought": "呆然", "narration": "悠真はあまりの出来事に言葉を失い、ただ呆然と彼女を見つめる。"}, {"speaker": "瀬川悠真", "speech": "ええっ！？", "thought": "驚愕", "narration": "悠真は驚きで声を跳ね上げ、身体をわずかに後ろに引く。"}, {"speaker": "瀬川悠真", "speech": "な、何を、どういう……！？", "thought": "パニック", "narration": "混乱した悠真は、泳ぐ視線をどこへ向ければいいのか分からなくなる。"}, {"speaker": null, "speech": null, "thought": null, "narration": "悠真はあまりの展開に混乱し、ただ立ち尽くすことしかできない。"}, {"speaker": null, "speech": null, "thought": null, "narration": "窓から差し込む夕日が、莉緒の熱を帯びた瞳と、混乱する悠真の姿を静かに照らしていた。"}]}]}, {"title": "揺れる境界線", "synopsis": "莉緒の告白を知った葵が、悠真との関係が変わってしまう恐怖と、初めて味わう強い嫉妬に直面する。", "turn_budget": 25, "scenes": [{"synopsis": "帰り道、悠真の様子がいつもと違うことに気づいた葵が、彼に理由を尋ね、莉緒から告白されたことを聞き出す。", "turn_budget": 14, "time_point": "夕暮れ", "location": "通学路", "turns": [{"speaker": null, "speech": null, "thought": null, "narration": "夕暮れ時、オレンジ色の光が通学路を長く照らしている。二人の足音だけが規則正しく響いていた。"}, {"speaker": "小野寺葵", "speech": "ねえ、悠真。さっきからずっと黙ってるけど、どうかしたの？", "thought": "心配", "narration": "悠真の横顔を覗き込む。"}, {"speaker": "瀬川悠真", "speech": "えっ、あ、いや……別に。なんでもないよ", "thought": "困惑", "narration": "視線を泳がせ、歩幅を乱す。"}, {"speaker": "小野寺葵", "speech": "嘘。顔がすごく硬いし、さっきから視線も泳いでる。何かあったんでしょ？", "thought": "疑念", "narration": "立ち止まって彼を見つめる。"}, {"speaker": "瀬川悠真", "speech": "……実はさ。さっき、水瀬さんに……", "thought": "躊躇", "narration": "言葉を飲み込み、俯く。"}, {"speaker": "瀬川悠真", "speech": "……付き合ってほしいって、言われたんだ", "thought": "申し訳なさ", "narration": "消え入りそうな声で告げる。"}, {"speaker": "小野寺葵", "speech": "へぇ、そうなんだ。水瀬さん、積極的だね", "thought": "衝撃", "narration": "ぎこちない笑顔を作る。"}, {"speaker": null, "speech": null, "thought": null, "narration": "葵は努めて明るい声を出したが、胸の奥がぎゅっと締め付けられるような感覚に襲われた。"}, {"speaker": "小野寺葵", "speech": "それで、なんて答えたの？", "thought": "恐怖", "narration": "震える声を押し殺して問う。"}, {"speaker": "瀬川悠真", "speech": "答えられなかった。あまりに突然すぎて、ただ、呆然としちゃって……", "thought": "後悔", "narration": "困ったように首を振る。"}, {"speaker": null, "speech": null, "thought": null, "narration": "二人の間に、沈黙が重くのしかかる。"}, {"speaker": "小野寺葵", "speech": "……そう。よかったじゃない、素敵なことだもん", "thought": "絶望", "narration": "視線を逸らして無理に笑う。"}, {"speaker": "瀬川悠真", "speech": "葵？ なんでそんなに急に歩き出すんだよ", "thought": "不安", "narration": "慌てて彼女の背中を追う。"}, {"speaker": null, "speech": null, "thought": null, "narration": "葵は答えず、逃げるように歩幅を広げる。夕闇が、当たり前だった距離が壊れてしまう予感を連れてきた。"}]}, {"synopsis": "莉緒の告白と悠真の保留を聞き、葵は平然を装いながらも、二人の関係が変わってしまう恐怖と激しい嫉妬に襲われる。", "turn_budget": 11, "time_point": "夕暮れ", "location": "通学路", "turns": [{"speaker": null, "speech": null, "thought": null, "narration": "夕暮れのオレンジ色が路面を長く引き伸ばしている。二人の間に流れる空気は、いつもより少しだけ重い。"}, {"speaker": "小野寺葵", "speech": "まだぼーっとしてる。さっきから全然返事がないよ", "thought": null, "narration": "葵は悠真の腕を軽く小突いた。"}, {"speaker": "瀬川悠真", "speech": "あ、ごめん。……いや、本当にびっくりしたんだ。莉緒さんに、あんな風に言われるなんて", "thought": null, "narration": "悠真は視線を落としたまま、困惑を隠せない様子で答えた。"}, {"speaker": "小野寺葵", "speech": "そんなにショック？ 幽霊でも見たような顔してるよ", "thought": null, "narration": "葵は努めて明るく振る舞おうとして、わざとらしく眉を上げた。"}, {"speaker": "小野寺葵", "speech": null, "thought": "もし彼が彼女を選んでしまったら、今のこの距離は壊れてしまう。そんな予感がして、胸が苦しい。", "narration": "葵は無理に作った笑顔を崩さないよう、前を向いたまま歩く。"}, {"speaker": "瀬川悠真", "speech": "なんて言えばいいか、まだ整理がついてなくて……", "thought": null, "narration": "悠真は困ったように眉を下げ、足元をぼんやりと見つめた。"}, {"speaker": "小野寺葵", "speech": "まあ、相手は可愛い子だしね。あんまり考えすぎても仕方ないよ", "thought": null, "narration": "葵は努めて明るいトーンで言った。"}, {"speaker": "小野寺葵", "speech": null, "thought": "どうしてこんなに苦しいんだろう。当たり前だと思っていた隣が、遠くなっていく気がする。", "narration": "葵は口角を無理に持ち上げ、表情を固定する。"}, {"speaker": null, "speech": null, "thought": null, "narration": "葵は歩く速度を上げ、悠真の横を追い越すようにして少し前を歩いた。"}, {"speaker": "小野寺葵", "speech": "ほら、ぼーっとしてると転ぶよ。しっかりして", "thought": null, "narration": "葵は背中越しに声をかけるが、その声はわずかに震えていた。"}, {"speaker": null, "speech": null, "thought": null, "narration": "葵のポケットの中で、握りしめられた拳がかすかに震えていた。"}]}]}, {"title": "言葉の重み", "synopsis": "葵が幼馴染の枠を超えて悠真を好きだと打ち明け、悠真もまた長年秘めてきた想いを言葉にする。", "turn_budget": 35, "scenes": [{"synopsis": "莉緒の告白を聞いたことで、葵は自分が悠真に対して抱いている感情が単なる幼馴染としての親愛ではなく、明確な恋心であることを自覚する。彼女は曖昧な関係を終わらせるため、恋人として付き合いたいとはっきりと伝える。", "turn_budget": 15, "time_point": "夕暮れ時", "location": "帰り道の静かな道", "turns": [{"speaker": null, "speech": null, "thought": null, "narration": "夕暮れの色が、静かな帰り道をオレンジ色に染めている。二人の足音だけが、規則正しく響いていた。"}, {"speaker": null, "speech": null, "thought": null, "narration": "普段通りの帰り道。しかし、二人の間に流れる空気は、どこか重く、張り詰めている。"}, {"speaker": "小野寺葵", "speech": "ねえ、悠真。さっきの話だけど……", "thought": "怖くてたまらない。", "narration": "葵は立ち止まり、俯いたまま言葉を絞り出す。"}, {"speaker": "小野寺葵", "speech": "莉緒ちゃんに告白されたって聞いて、私、すごく怖くなったんだ。", "thought": "どう伝えればいいの。", "narration": "彼女の肩が、微かに震えている。"}, {"speaker": "小野寺葵", "speech": "ずっと隣にいるのが当たり前だと思ってた。私が今まで感じていたのは、ただの幼馴染としての親愛じゃない。", "thought": "幼馴染のままじゃダメなんだ。", "narration": "葵は視線を落としたまま、消え入りそうな声で続ける。"}, {"speaker": "小野寺葵", "speech": "……私、悠真のことが好きだよ。", "thought": "言えた。でも、まだ足りない。", "narration": "顔を上げた彼女の瞳には、強い決意と微かな涙が浮かんでいる。"}, {"speaker": "小野寺葵", "speech": "伝わってほしい。この気持ちが、ただの遊びじゃないって。", "thought": "伝わってほしい。", "narration": "オレンジ色の光が、彼女の濡れた瞳を照らし、その表情をいっそう切なく際立たせている。"}, {"speaker": null, "speech": null, "thought": null, "narration": "夕陽が、彼女の頬を流れる涙を金色の雫に変えていた。"}, {"speaker": "小野寺葵", "speech": "誰か他の女の子の恋人になるなんて、絶対に嫌。これ以上、曖昧な関係のままなのは、もう耐えられないの。", "thought": "あんな風に、誰か他の人のものになっちゃうなんて。", "narration": "葵は一歩、悠真に歩み寄る。"}, {"speaker": "小野寺葵", "speech": "幼馴染としてじゃなくて、恋人として、私と付き合ってほしい。お願い。", "thought": "曖昧なのはもう嫌。", "narration": "彼女は悠真の服の裾を、離さないという意志を込めてぎゅっと握りしめた。"}, {"speaker": "小野寺葵", "speech": "悠真。私のこと、ちゃんと見て。", "thought": "お願い、受け止めて。", "narration": "潤んだ瞳で、彼女は切実に願いをかける。"}, {"speaker": "小野寺葵", "speech": "……これでも、まだ幼馴染のままがいいって言うの？", "thought": "これでも、まだ幼馴染のままがいいって言うの？", "narration": "彼女は握った裾をさらに強く引き寄せた。"}, {"speaker": "瀬川悠真", "speech": "葵……。え、あ、いや、本当に……？", "thought": "嘘じゃないよね？", "narration": "悠真は言葉を失い、ただ呆然と彼女を見つめている。"}, {"speaker": "瀬川悠真", "speech": "冗談じゃないよね？ 夢を見てるんじゃないのか……？", "thought": "夢じゃないよね？", "narration": "悠真の心臓が、耳元でうるさく響いている。"}, {"speaker": null, "speech": null, "thought": null, "narration": "夕陽が沈みかけ、二人の間に落ちる影が長く伸びていく。静寂の中に、二人の荒い呼吸だけが混じっていた。"}]}, {"synopsis": "葵の告白に驚きながらも、悠真は自分自身がずっと彼女を特別に想い続けてきたことを明かす。長年の片思いを言葉にし、二人は幼馴染という枠を超えて結ばれる。", "turn_budget": 20, "time_point": "告白の直後", "location": "公園のベンチ", "turns": [{"speaker": null, "speech": null, "thought": null, "narration": "夕暮れの公園。ベンチに並んで座る二人の間に、言葉にならない沈黙が流れる。"}, {"speaker": "小野寺葵", "speech": "「……驚かせちゃったかな」", "thought": "怖い", "narration": "葵は視線を落とし、指先を弄びながら悠真の返答を待つ。"}, {"speaker": "瀬川悠真", "speech": "「……いや、驚いてるのは俺の方だよ」", "thought": "緊張", "narration": "悠真は深く息を吐き、葵の横顔をじっと見つめる。"}, {"speaker": "瀬川悠真", "speech": "「莉緒さんに告白されて、やっと気づいたんだ。俺がずっと隠してきた気持ちに」", "thought": "決意", "narration": "悠真は少し震える声で、自身の本心を言葉にする。"}, {"speaker": "瀬川悠真", "speech": "「俺も、ずっと前から葵が好きだった。幼馴染としてじゃなくて、一人の女の子として」", "thought": "告白", "narration": "悠真は意を決して、葵の手をそっと握る。"}, {"speaker": "小野寺葵", "speech": "「……えっ」", "thought": "驚き", "narration": "葵は目を見開き、握られた手の温もりに肩を震わせる。"}, {"speaker": "瀬川悠真", "speech": "「ずっと言えなかったけど、本当は葵のことが、ずっと特別だったんだ」", "thought": "安堵", "narration": "悠真は照れくさそうに笑いながら、握る手に力を込める。"}, {"speaker": "瀬川悠真", "speech": "「だから……俺と、付き合ってくれないかな？」", "thought": "期待", "narration": "悠真は真っ直ぐに葵の瞳を見つめて問いかける。"}, {"speaker": "小野寺葵", "speech": "「……うん、もちろん。……やっと言ってくれたね」", "thought": "幸福", "narration": "葵の瞳に涙が浮かび、彼女は悠真の肩に頭を預ける。"}, {"speaker": "瀬川悠真", "speech": "「よかった……本当に、よかった」", "thought": "安堵", "narration": "悠真はこらえきれず、彼女の肩を強く抱き寄せた。"}, {"speaker": "小野寺葵", "speech": "「……ずっと、怖かったんだよ」", "thought": "不安", "narration": "葵は悠真のシャツをぎゅっと掴み、震える声で呟く。"}, {"speaker": "瀬川悠真", "speech": "「もう大丈夫だよ。俺はどこにも行かないから」", "thought": "優しさ", "narration": "悠真は彼女の頭を優しく撫で、安心させるように囁く。"}, {"speaker": "小野寺葵", "speech": "「約束だよ。絶対に、裏切らないでね」", "thought": "願い", "narration": "葵は潤んだ瞳で彼を見上げ、念を押すように言う。"}, {"speaker": "瀬川悠真", "speech": "「約束する。葵を泣かせたりしない」", "thought": "決意", "narration": "悠真は力強く頷き、彼女の指に自分の指を絡ませる。"}, {"speaker": "小野寺葵", "speech": "「ふふ、なんだか、すごく幸せ」", "thought": "喜び", "narration": "葵は顔を赤らめながら、幸せそうに微笑んだ。"}, {"speaker": "瀬川悠真", "speech": "「俺もだよ。……ずっと、こうして隣にいたかった」", "thought": "幸福", "narration": "悠真は彼女の頬をそっと撫で、愛おしそうに見つめる。"}, {"speaker": "小野寺葵", "speech": "「もう、照れちゃうじゃない」", "thought": "照れ", "narration": "葵は彼の胸に顔を埋め、幸せな吐息をつく。"}, {"speaker": "瀬川悠真", "speech": "「じゃあ、そろそろ帰ろうか」", "thought": "日常", "narration": "悠真は立ち上がり、彼女の手を優しく引く。"}, {"speaker": "小野寺葵", "speech": "「うん、行こう」", "thought": "喜び", "narration": "葵は嬉しそうに頷き、彼の手を握り返す。"}, {"speaker": null, "speech": null, "thought": null, "narration": "茜色の空の下、二人の距離は幼馴染のそれよりもずっと近く、確かなものへと変わった。"}]}]}, {"title": "一番近くの恋人", "synopsis": "想いを通わせた二人が、莉緒に対して自分たちの関係をはっきりと宣言する。", "turn_budget": 10, "scenes": [{"synopsis": "想いを通わせた悠真と葵が、莉緒に対して自分たちの関係をはっきりと宣言する。", "turn_budget": 10, "time_point": "放課後", "location": "学校の廊下", "turns": [{"speaker": null, "speech": null, "thought": null, "narration": "夕暮れの廊下。悠真と葵は、互いの想いを確認し合った後の余韻に浸りながら、ゆっくりと歩いていた。"}, {"speaker": null, "speech": null, "thought": null, "narration": "二人の距離はこれまでの幼馴染としてのそれよりもずっと近く、触れ合う肩の熱が心地よく感じられた。"}, {"speaker": "水瀬莉緒", "speech": "あの、瀬川くん。", "thought": null, "narration": "莉緒が二人の前に立ちふさがり、期待と不安が混ざった瞳で悠真を真っ直ぐに見つめた。"}, {"speaker": "水瀬莉緒", "speech": "さっきの、返事は……まだもらえないかな？", "thought": null, "narration": "彼女の声は少し震えていたが、一目惚れした相手への真っ直ぐな願いが込められていた。"}, {"speaker": "小野寺葵", "speech": "ごめんね、莉緒ちゃん。でも、悠真は、私の恋人だから。", "thought": "独占欲", "narration": "葵は顔を赤らめながらも、悠真の腕に自分の腕を絡め、彼を離さないという意思を示すように強く抱き寄せた。"}, {"speaker": null, "speech": null, "thought": null, "narration": "葵の腕は悠真の二の腕をしっかりと掴み、まるで自分の所有物であることを周囲に誇示しているかのようだった。"}, {"speaker": "瀬川悠真", "speech": "……そうだね。俺も、葵の言う通りだよ。", "thought": "愛情", "narration": "悠真は莉緒に対して申し訳なさを感じつつも、隣にいる葵の肩を優しく引き寄せた。"}, {"speaker": null, "speech": null, "thought": null, "narration": "悠真が葵を抱き寄せる動作は、先ほどまでの気安い幼馴染のそれではなく、確かな愛着を伴う恋人のものだった。"}, {"speaker": null, "speech": null, "thought": null, "narration": "莉緒は言葉を失い、二人の間に流れる確かな空気を見つめて、その場に立ち尽くしていた。"}, {"speaker": null, "speech": null, "thought": null, "narration": "夕暮れの廊下には、突き放された莉緒の静かな沈黙と、恋人同士になった二人の幸福な気配だけが漂っていた。"}]}]}], "ending": "幼馴染という曖昧な関係を卒業し、悠真と葵が互いの恋心を確かなものとして結ばれる。"}, "directing": [[[{"witnesses": ["瀬川悠真", "小野寺葵"], "observation": "夕暮れの光が机を並べる二人を照らしている", "learned": []}, {"witnesses": ["瀬川悠真", "小野寺葵"], "observation": "葵がメロンパンを悠真に差し出している", "learned": []}, {"witnesses": ["瀬川悠真", "小野寺葵"], "observation": "悠真がパンを受け取っている", "learned": []}, {"witnesses": ["瀬川悠真", "小野寺葵"], "observation": "葵が自信ありげに微笑んでいる", "learned": []}, {"witnesses": ["瀬川悠真", "小野寺葵"], "observation": "悠真が困ったように笑っている", "learned": []}, {"witnesses": ["瀬川悠真", "小野寺葵"], "observation": "葵が悠真を指さして明日を促している", "learned": []}, {"witnesses": ["瀬川悠真", "小野寺葵", "水瀬莉緒"], "observation": "莉緒が入り口から近づいてくる", "learned": []}, {"witnesses": ["瀬川悠真", "小野寺葵", "水瀬莉緒"], "observation": "莉緒が悠真に声をかけている", "learned": [{"actor": "水瀬莉緒", "subject": "瀬川悠真", "fact": "莉緒が教室にいた悠真を見つけた"}]}, {"witnesses": ["瀬川悠真", "小野寺葵", "水瀬莉緒"], "observation": "悠真が驚いて莉緒を見ている", "learned": []}, {"witnesses": ["瀬川悠真